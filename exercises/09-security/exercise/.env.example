# Copiar para .env e mudar as passwords. Nunca fazer commit do .env.
# O .env de cima (raiz do repositório) tem as passwords de administrador; este tem as do exercício.

# PostgreSQL: passwords dos 3 roles (usadas por roles.sql) e a ligação da API (ex09_app)
EX09_MIGRATIONS_PASSWORD=change-me-ex09-migrations
EX09_APP_PASSWORD=change-me-ex09-app
EX09_READONLY_PASSWORD=change-me-ex09-readonly
DATABASE_URL=postgresql://ex09_app:change-me-ex09-app@localhost:5432/ex09

# MongoDB: utilizador ex09_app com readWrite só na base ex09
MONGO_APP_PASSWORD=change-me-ex09-mongo
MONGO_URL=mongodb://ex09_app:change-me-ex09-mongo@localhost:27017/ex09?authSource=ex09

# Redis: utilizador ACL ex09_app que só pode fazer INCR em chaves counter:*
REDIS_APP_PASSWORD=change-me-ex09-redis
REDIS_URL=redis://ex09_app:change-me-ex09-redis@localhost:6379/0
