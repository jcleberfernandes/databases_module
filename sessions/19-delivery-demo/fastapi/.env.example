# Copy to .env. The passwords must match the .env at the root of the repository.
DATABASE_URL=postgresql+psycopg://postgres:change-me-postgres@localhost:5432/s19_fastapi
# /1 is the logical database index this project uses inside Redis.
REDIS_URL=redis://:change-me-redis@localhost:6379/1
# Where demo-concurrency sends its requests.
API_URL=http://localhost:8000
# Rows in big_rental for demo-explain (the session 07 tutorial uses 2,000,000).
BIG_RENTAL_ROWS=2000000
