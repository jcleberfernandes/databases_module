# Copy to .env. The passwords must match the .env at the root of the repository.
DATABASE_URL=postgresql+psycopg://postgres:change-me-postgres@localhost:5432/s17_fastapi
MONGO_URL=mongodb://root:change-me-mongo@localhost:27017/?authSource=admin
MONGO_DB=s17_fastapi
# /1 is the logical database index this project uses inside Redis.
REDIS_URL=redis://:change-me-redis@localhost:6379/1

# Used by the shell scripts (backup, restore, verify), which run the database
# tools inside the containers with docker compose exec.
PG_USER=postgres
PG_DB=s17_fastapi

# Where the concurrency tests send their requests.
API_URL=http://localhost:8000
