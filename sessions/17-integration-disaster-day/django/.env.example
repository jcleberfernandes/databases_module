# Copy to .env. The passwords must match the .env at the root of the repository.
DATABASE_URL=postgresql://postgres:change-me-postgres@localhost:5432/s17_django
# The monthly report and the Redis rebuild only read PostgreSQL. Point this at the
# readonly role from session 09 if you created it; it defaults to DATABASE_URL.
READONLY_DATABASE_URL=postgresql://postgres:change-me-postgres@localhost:5432/s17_django
MONGO_URL=mongodb://root:change-me-mongo@localhost:27017/?authSource=admin
MONGO_DB=s17_django
# /2 is the logical database this project uses inside the shared Redis server.
REDIS_URL=redis://:change-me-redis@localhost:6379/2
DJANGO_SECRET_KEY=change-me-django
DJANGO_DEBUG=true
# Where tests/concurrency sends its requests.
API_URL=http://localhost:8001
