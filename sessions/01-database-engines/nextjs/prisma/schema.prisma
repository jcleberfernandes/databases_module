generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Hello {
  id        Int      @id @default(autoincrement())
  msg       String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("hello")
}
