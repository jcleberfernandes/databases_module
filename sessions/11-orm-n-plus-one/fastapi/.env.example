# Copy to .env. The password must match the .env at the root of the repository.
# postgresql+psycopg:// tells SQLAlchemy to use the psycopg 3 driver.
DATABASE_URL=postgresql+psycopg://postgres:change-me-postgres@localhost:5432/s11_fastapi
# true prints every SQL statement in the uvicorn terminal (create_engine echo=True).
SQL_ECHO=true
