# Copy to .env. The passwords must match the .env at the root of the repository.
# The rebuild and verify only read PostgreSQL. In your project this is the `readonly`
# role from session 09; here it is the same user, and the code opens read-only transactions.
READONLY_DATABASE_URL=postgresql://postgres:change-me-postgres@localhost:5432/s16_fastapi
# /1 is the logical database index this project uses inside Redis.
REDIS_URL=redis://:change-me-redis@localhost:6379/1
