# Copy to .env. Never commit .env. The admin passwords must match the .env at the root of the repository.

# PostgreSQL superuser: used only by scripts/setup_postgres.py.
ADMIN_DATABASE_URL=postgresql://postgres:change-me-postgres@localhost:5432/s09_fastapi
# Passwords for the three roles. Roles belong to the whole server, not to one database.
MIGRATIONS_PASSWORD=change-me-migrations
APP_PASSWORD=change-me-app
READONLY_PASSWORD=change-me-readonly
# What the application uses.
DATABASE_URL=postgresql://app:change-me-app@localhost:5432/s09_fastapi
READONLY_DATABASE_URL=postgresql://readonly:change-me-readonly@localhost:5432/s09_fastapi

# MongoDB root: used only by scripts/setup_mongo.py to create the application user.
MONGO_ADMIN_URL=mongodb://root:change-me-mongo@localhost:27017/?authSource=admin
MONGO_DB=s09_fastapi
MONGO_APP_PASSWORD=change-me-mongo-app
MONGO_URL=mongodb://app:change-me-mongo-app@localhost:27017/s09_fastapi?authSource=s09_fastapi

# Redis default user: used only by scripts/setup_redis.py to create the ACL user.
REDIS_ADMIN_URL=redis://:change-me-redis@localhost:6379/1
REDIS_APP_USER=s09_fastapi_app
REDIS_APP_PASSWORD=change-me-redis-app
REDIS_URL=redis://s09_fastapi_app:change-me-redis-app@localhost:6379/1
