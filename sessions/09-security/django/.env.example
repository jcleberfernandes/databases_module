# Copy to .env. Never commit .env. The admin passwords must match the .env at the root of the repository.

# PostgreSQL superuser: used only by `manage.py setup_roles`.
ADMIN_DATABASE_URL=postgresql://postgres:change-me-postgres@localhost:5432/s09_django
# Passwords for the three roles, used when setup_roles creates them.
# Roles belong to the whole server, so every project uses the same three.
MIGRATIONS_PASSWORD=change-me-migrations
APP_PASSWORD=change-me-app
READONLY_PASSWORD=change-me-readonly
# What the application uses.
DATABASE_URL=postgresql://app:change-me-app@localhost:5432/s09_django
READONLY_DATABASE_URL=postgresql://readonly:change-me-readonly@localhost:5432/s09_django
MIGRATIONS_DATABASE_URL=postgresql://migrations:change-me-migrations@localhost:5432/s09_django

# MongoDB root: used only by `manage.py setup_mongo` to create the application user.
MONGO_ADMIN_URL=mongodb://root:change-me-mongo@localhost:27017/?authSource=admin
MONGO_DB=s09_django
MONGO_APP_PASSWORD=change-me-mongo-app
MONGO_URL=mongodb://app:change-me-mongo-app@localhost:27017/s09_django?authSource=s09_django

# Redis default user: used only by `manage.py setup_redis` to create the ACL user.
REDIS_ADMIN_URL=redis://:change-me-redis@localhost:6379/2
REDIS_APP_USER=s09_django_app
REDIS_APP_PASSWORD=change-me-redis-app
REDIS_URL=redis://s09_django_app:change-me-redis-app@localhost:6379/2

DJANGO_SECRET_KEY=change-me-django
DJANGO_DEBUG=true
