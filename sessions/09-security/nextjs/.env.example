# Copy to .env. Never commit .env. The admin passwords must match the .env at the root of the repository.

# PostgreSQL superuser: used only by scripts/setup-postgres.ts.
ADMIN_DATABASE_URL=postgresql://postgres:change-me-postgres@localhost:5432/s09_nextjs
# Passwords for the three roles, used only when setup-postgres creates them.
# Roles belong to the whole server, so every project uses the same three.
MIGRATIONS_PASSWORD=change-me-migrations
APP_PASSWORD=change-me-app
READONLY_PASSWORD=change-me-readonly
# What the application and the Prisma CLI use.
DATABASE_URL=postgresql://app:change-me-app@localhost:5432/s09_nextjs
READONLY_DATABASE_URL=postgresql://readonly:change-me-readonly@localhost:5432/s09_nextjs
MIGRATIONS_DATABASE_URL=postgresql://migrations:change-me-migrations@localhost:5432/s09_nextjs

# MongoDB root: used only by scripts/setup-mongo.ts to create the application user.
MONGO_ADMIN_URL=mongodb://root:change-me-mongo@localhost:27017/?authSource=admin
MONGO_DB=s09_nextjs
MONGO_APP_PASSWORD=change-me-mongo-app
MONGO_URL=mongodb://app:change-me-mongo-app@localhost:27017/s09_nextjs?authSource=s09_nextjs

# Redis default user: used only by scripts/setup-redis.ts to create the ACL user.
REDIS_ADMIN_URL=redis://:change-me-redis@localhost:6379/3
REDIS_APP_USER=s09_nextjs_app
REDIS_APP_PASSWORD=change-me-redis-app
REDIS_URL=redis://s09_nextjs_app:change-me-redis-app@localhost:6379/3
