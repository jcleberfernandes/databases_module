# Copy to .env. The passwords must match the .env at the root of the repository.
DATABASE_URL=postgresql://postgres:change-me-postgres@localhost:5432/s14_django
# The frozen report reads PostgreSQL through this URL. Point it at the readonly
# role from session 09 if you created it; it defaults to DATABASE_URL.
READONLY_DATABASE_URL=postgresql://postgres:change-me-postgres@localhost:5432/s14_django
MONGO_URL=mongodb://root:change-me-mongo@localhost:27017/?authSource=admin
MONGO_DB=s14_django
DJANGO_SECRET_KEY=change-me-django
DJANGO_DEBUG=true
