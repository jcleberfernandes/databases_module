# Copy to .env. The passwords must match the .env at the root of the repository.
DATABASE_URL=postgresql://postgres:change-me-postgres@localhost:5432/s15_django
# /2 is the logical database this project uses inside the shared Redis server.
REDIS_URL=redis://:change-me-redis@localhost:6379/2
# Requests per minute per client on GET /search.
RATE_LIMIT=10
DJANGO_SECRET_KEY=change-me-django
DJANGO_DEBUG=true
