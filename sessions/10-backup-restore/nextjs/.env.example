# Copy to .env. The password must match the .env at the root of the repository.
DATABASE_URL=postgresql://postgres:change-me-postgres@localhost:5432/s10_nextjs
# Where npm run restore restores to, and the default second database for npm run verify.
RESTORE_DB=s10_nextjs_restored
# Name of the throwaway container used by npm run clean-container-test.
TEST_CONTAINER=s10-nextjs-pgtest
